# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase Postgres connection string (Project → Settings → Database).
# Use the connection-pooler URI for serverless-friendly connections.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# WHOOP developer app (https://developer-dashboard.whoop.com).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback
